# ------------------------------------------------------------------
# RouteWise environment configuration
# Copy this file to .env and adjust values. Never commit the real .env.
# ------------------------------------------------------------------

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=routewise
DB_USERNAME=routewise
DB_PASSWORD=routewise
MYSQL_ROOT_PASSWORD=rootpassword

# JWT
JWT_SECRET=change-this-dev-only-secret-key-must-be-long-enough-for-hs256
JWT_EXPIRATION_MS=86400000

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# CORS (comma-separated origins allowed to call the backend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo/seed data password (used for admin/driver/hospital/citizen demo accounts)
DEMO_PASSWORD=Demo@1234

# Optional: only needed if you wire in a paid map/traffic provider.
# RouteWise runs fully without this using its built-in simulated road network.
# MAP_PROVIDER_API_KEY=
